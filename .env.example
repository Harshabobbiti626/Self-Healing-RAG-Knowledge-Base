# ========================================================
# Self-Healing RAG Knowledge Base - Environment Configuration
# ========================================================

# Model & Provider Configuration
# Supported providers: "openai", "gemini", "mock" (for offline testing & development)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM Model Identifiers (Options: gpt-4o-mini, gemini-3.1-flash-lite)
SYNTHESIS_MODEL=gpt-4o-mini
GRADER_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB Configuration (Qdrant)
# Use ":memory:" for in-memory, or specify QDRANT_URL and QDRANT_API_KEY for Qdrant Cloud
QDRANT_LOCATION=:memory:
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=self_healing_knowledge_base
VECTOR_SIZE=1536

# Fast-Loop RAG Thresholds
RELEVANCE_THRESHOLD=0.65
MAX_RETRIES=2
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5

# Slow-Loop Continuous Healing Thresholds
LOW_CONFIDENCE_LOG_THRESHOLD=0.50
FAILURE_BUFFER_MAX_SIZE=100
AUTO_HEAL_CRON_INTERVAL_MINUTES=60
CONTRADICTION_SIMILARITY_THRESHOLD=0.82

# Telemetry & Observability
ENABLE_TELEMETRY=true
TELEMETRY_LOG_PATH=./data/telemetry.jsonl
